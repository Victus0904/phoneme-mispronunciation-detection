# Copy this file to .env and paste your free-tier keys (leave any you don't have empty).
# .env is git-ignored and only read by server.py -- keys are never sent to the browser.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

